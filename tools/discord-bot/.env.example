# Meltype の Discord bot の設定。このファイルを .env にコピーして書き換える (.env は Git に入れない)。

# Discord の bot のトークン (Discord Developer Portal → Applications → Bot → Reset Token)。ほかの人に見せない
DISCORD_TOKEN=

# この カテゴリーの中のチャンネルでだけ使える
CATEGORY_ID=1554763635782455356

# add-list でリストに入れられるチャンネルと、その種類
MISCONVERSION_CHANNEL_ID=1554765525312208938
BUG_CHANNEL_ID=1554763767722549318
IDEA_CHANNEL_ID=1554763815130763327

# close-list / submit-list を使える役職の ID (空なら「メッセージの管理」の権限がある人と、リストに入れた本人)
MANAGER_ROLE_ID=

# henkan-test / jht: Meltype のテスト用プログラムの場所。
#   Windows なら Meltype.Tests.dll がおすすめ (漢字の読みを Microsoft IME で自動で求める・Windows のスペルチェッカーを使う):
#     npm run deploy-runner で runner/ に置く (開発中のビルドと取り合わないように、bot 用に別の場所へ)
#   Windows 以外は Meltype.Core.Tests.dll (jht では「/ 読み」を書いてもらう):
#   dotnet build src/Meltype.Core.Tests -c Release で作る: src/Meltype.Core.Tests/bin/Release/net10.0/Meltype.Core.Tests.dll
MELTYPE_DLL=runner/Meltype.Tests.dll
# Mozc の変換ヘルパー (あれば漢字に変換する。無ければ日本語 / 英語の判定だけ)
#   Windows: ../../native/mozc/bin/meltype_mozc_helper.exe  Linux: ../../native/mozc/bin/linux/meltype_mozc_helper
MELTYPE_MOZC=../../native/mozc/bin/meltype_mozc_helper.exe

# リストを保存するファイル
DATA_FILE=data/list.json
