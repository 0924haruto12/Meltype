<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AutoIME</AssemblyName>
    <RootNamespace>AutoIME</RootNamespace>
    <Version>0.1.0</Version>
    <Product>AutoIME</Product>
    <Authors>Yukishiro</Authors>
    <Copyright>Copyright (C) 2026 雪代 / Yukishiro. GPL-3.0-or-later</Copyright>
    <Description>半角/全角 キーを押さなくても日本語と英語を打ち分けられるようにする常駐ツール</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WinRtCandidates で COM の関数表を直接呼ぶため -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AutoIME.Tests" />
    <EmbeddedResource Include="..\..\dictionaries\*.txt" LogicalName="AutoIME.dictionaries.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
